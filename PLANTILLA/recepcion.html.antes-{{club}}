function getPlayerRecData(playerKey){
  // Returns reception structure filtered by CUR_RIVAL
  if(!window.RECEPCION_RIVAL_DATA || !window.RECEPCION_RIVAL_DATA[playerKey]) return null;
  var pd = window.RECEPCION_RIVAL_DATA[playerKey];
  if(CUR_RIVAL === 'TODOS') return pd.acumulado;
  return pd.por_rival[CUR_RIVAL] || null;
}


function calcEquipoDataRival(rival){
  // Aggregate all receptors for a specific rival
  if(!window.RECEPCION_RIVAL_DATA) return null;
  var agg = {flotado:{},potencia:{}};
  ['flotado','potencia'].forEach(function(tp){
    ['desde_z1','desde_z6','desde_z5'].forEach(function(dz){
      agg[tp][dz]={p1:{tot:0,eff:0,pos:0,neg:0,err:0,perf:0},p6:{tot:0,eff:0,pos:0,neg:0,err:0,perf:0},p5:{tot:0,eff:0,pos:0,neg:0,err:0,perf:0}};
    });
  });
  Object.keys(window.RECEPCION_RIVAL_DATA).forEach(function(p){
    var pr = window.RECEPCION_RIVAL_DATA[p].por_rival[rival];
    if(!pr) return;
    ['flotado','potencia'].forEach(function(tp){
      ['desde_z1','desde_z6','desde_z5'].forEach(function(dz){
        ['p1','p6','p5'].forEach(function(pz){
          var src=pr[tp]&&pr[tp][dz]&&pr[tp][dz][pz];
          if(src){var a=agg[tp][dz][pz];a.tot+=src.tot||0;a.perf+=src.perf||0;a.pos+=src.pos||0;a.neg+=src.neg||0;a.err+=src.err||0;}
        });
      });
    });
  });
  // recompute eff
  ['flotado','potencia'].forEach(function(tp){
    ['desde_z1','desde_z6','desde_z5'].forEach(function(dz){
      ['p1','p6','p5'].forEach(function(pz){
        var c=agg[tp][dz][pz];
        c.eff = c.tot? Math.round((c.perf+0.5*c.pos-0.5*c.neg-c.err)/c.tot*100):0;
      });
    });
  });
  return agg;
}

function render(){
  var d;
  if(CUR === 'EQUIPO'){
