<script>
// ── ENT filter — independent of initReceptores/render ────────────────
window._recMode = 'partido'; // 'partido' or 'entrenamiento'

function recSetTipo(tipo, btn){
  window._recMode = tipo;
  // Update button styles
  document.getElementById('rec-tbtn-p').style.cssText = tipo==='partido'
    ? "padding:5px 12px;border-radius:8px;border:1px solid rgba(232,25,44,.4);background:rgba(232,25,44,.12);color:#e8192c;font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:800;letter-spacing:1.5px;cursor:pointer;text-transform:uppercase"
